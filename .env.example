# FileDeck environment overrides. Every setting can also live in filedeck.toml;
# precedence is: environment variable > filedeck.toml > built-in default.

# --- server ---
FILEDECK_HOST=0.0.0.0
FILEDECK_PORT=8080
# FILEDECK_CONFIG=C:\path\to\filedeck.toml

# --- storage (defaults to %LOCALAPPDATA%\filedeck on Windows, ~/.local/share/filedeck elsewhere) ---
# FILEDECK_MEDIA_ROOT=
# FILEDECK_CONSUME_DIR=
# FILEDECK_INDEX_DIR=
# FILEDECK_DATABASE_URL=sqlite://C:/path/to/db.sqlite3

# --- worker ---
FILEDECK_WORKER_URL=http://127.0.0.1:8900
# WORKER_SECRET=

# --- OCR (needs the tesseract binary; `pip install .[ocr]` in worker/ for pytesseract + ocrmypdf) ---
FILEDECK_OCR_LANGUAGE=eng

# --- consume folder / ingestion ---
FILEDECK_CONSUMER_WATCH=true
FILEDECK_CONSUMER_DELETE=true
FILEDECK_CONSUMER_ENABLE_BARCODES=true
FILEDECK_CONSUMER_BARCODE_STRING=PATCHT
FILEDECK_CONSUMER_ENABLE_ASN_BARCODE=true
FILEDECK_CONSUMER_ASN_BARCODE_PREFIX=ASN
# FILEDECK_CONSUMER_IGNORE_PATTERNS=.DS_Store,Thumbs.db,~$*,.*

# --- AI (Phase 8) ---
FILEDECK_AI_ENABLED=false
